# Server-only Cloudinary credentials. Never expose the API secret in browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=health-and-travels
# Required by /media-upload.html through the Vercel signing endpoint.
MEDIA_UPLOAD_KEY=
